# OpenRouter Mercury Environment Variables
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
MERCURY_MODEL="inception/mercury-decide"

# Jina Reader Environment Variables
JINA_API_KEY="YOUR_JINA_API_KEY"
